{
  "name": "mystic-puzzles",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build --base=./",
    "build:pages": "tsc -b && vite build --base=/My-game/",
    "build:yandex": "tsc -b && vite build --base=./ --mode yandex",
    "package:yandex": "python3 tools/package-yandex.py",
    "test:browser": "node tests/browser-victory.mjs && node tests/browser-level-six.mjs && node tests/browser-task23.mjs && node tests/browser-level-select.mjs && node tests/browser-puzzle-polish.mjs && node tests/browser-gallery-completion-polish.mjs",
    "test:release": "node tests/browser-release-archive.mjs",
    "test:yandex:browser": "node tests/browser-yandex-sdk.mjs",
    "test:collection": "node tests/browser-collection.mjs",
    "test:menu": "node tests/browser-menu.mjs",
    "test": "node --test"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "playwright": "^1.62.1",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
